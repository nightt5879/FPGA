---
interface PageEntry {
  lang: "zh" | "en";
  slug: string;
  title: string;
  group: string;
  order: number;
}

interface Props {
  lang: "zh" | "en";
  currentSlug?: string;
  pages: PageEntry[];
}

const { lang, currentSlug, pages } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const groups = new Map<string, PageEntry[]>();

for (const page of pages.sort((a, b) => a.order - b.order)) {
  if (!groups.has(page.group)) {
    groups.set(page.group, []);
  }
  groups.get(page.group)?.push(page);
}
---

<aside class="sidebar" aria-label={lang === "zh" ? "章节导航" : "Section navigation"}>
  <p class="sidebar-title">{lang === "zh" ? "章节" : "Sections"}</p>
  {[...groups.entries()].map(([group, items]) => (
    <nav class="nav-group" aria-label={group}>
      <strong>{group}</strong>
      {items.map((item) => (
        <a href={`${base}${lang}/${item.slug}/`} aria-current={currentSlug === item.slug ? "page" : undefined}>
          {item.title}
        </a>
      ))}
    </nav>
  ))}
</aside>
